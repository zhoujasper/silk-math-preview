\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{silkmath-fixture}[2026/08/21 Silk Math visual fixture package]

% 本文件给预览扩展测「.sty 里声明、.tex/.md 里使用」。
% 把光标放进引用这些命令的公式里，应能展开，而不是红字未知命令。

\newcommand{\eps}{\varepsilon}
\newcommand{\R}{\mathbb{R}}
\newcommand{\N}{\mathbb{N}}
\newcommand{\C}{\mathbb{C}}
\newcommand{\A}{\mathbf{A}}
\newcommand{\B}{\mathbf{B}}
\newcommand{\norm}[1]{\left\lVert #1 \right\rVert}
\newcommand{\abs}[1]{\left\lvert #1 \right\rvert}
\newcommand{\pd}[2]{\frac{\partial #1}{\partial #2}}
\newcommand{\ip}[2]{\left\langle #1,#2 \right\rangle}
\renewcommand{\vec}[1]{\mathbf{#1}}

\DeclareMathOperator{\Tr}{Tr}
\DeclareMathOperator{\diag}{diag}
\DeclareMathOperator*{\argmin}{arg\,min}

% 字体族声明：预览会折成 \mathcal，\Ocal 才能渲染。
\DeclareMathAlphabet{\CMcal}{OMS}{cmsy}{m}{n}
\newcommand{\Ocal}{\CMcal{O}}

\definecolor{Accent}{rgb}{0.42,0.65,0.98}
\definecolor{Ok}{RGB}{46,160,67}
\colorlet{Warn}{red}

% begin 部分进入数学模式，应被当成公式区域。
% 真实 .cls 经常用 equation/align 包一层；预览必须自己折成可嵌套形式。
\newenvironment{eqmath}{\begin{equation}}{\end{equation}}
\newenvironment{almath}{\begin{align}}{\end{align}}
